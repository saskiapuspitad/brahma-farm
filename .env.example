# ==== Database ====
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://brahma:brahma_secret@localhost:5432/brahmafarm?schema=public"

# ==== Auth (JWT) ====
# Buat secret acak kuat, mis: openssl rand -base64 48
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-panjang"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-berbeda"
JWT_ACCESS_TTL="900"          # detik (15 menit)
JWT_REFRESH_TTL="1209600"     # detik (14 hari)

# ==== App ====
NODE_ENV="development"
APP_TIMEZONE="Asia/Jakarta"
APP_CURRENCY="IDR"

# ==== Akun admin awal (dipakai oleh prisma/seed.ts) ====
SEED_ADMIN_EMAIL="admin@brahmafarm.local"
SEED_ADMIN_PASSWORD="ubah-password-ini"
SEED_ADMIN_NAME="Super Admin"

# ==== File storage ====
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"

# ==== (Tahap 2) Redis untuk background job ====
REDIS_URL="redis://localhost:6379"
